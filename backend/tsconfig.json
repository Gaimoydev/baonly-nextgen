{
  "$schema": "https://json.schemastore.org/tsconfig",

  // NestJS 11 + Node 22 + Prisma 7。
  //
  // 三个必须记住的点：
  //   1. module=commonjs 说的是 **产物** 格式；源码照样写 ESM import。
  //      NestJS 的 DI 依赖 CJS 的模块求值时序，不要擅自改成 ESM 输出。
  //   2. experimentalDecorators + emitDecoratorMetadata 是 NestJS/class-validator
  //      的地基。emitDecoratorMetadata 会把构造器参数类型写进 design:paramtypes，
  //      DI 靠它解析依赖 —— 所以 verbatimModuleSyntax 必须为 false，
  //      否则「只用作类型的 import」会被擦掉，注入直接变 Object 而失败。
  //   3. useDefineForClassFields=false：legacy 装饰器（experimentalDecorators）
  //      与 [[Define]] 语义的类字段互相打架，字段初始化会覆盖装饰器写入的值。
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "verbatimModuleSyntax": false,

    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "declaration": false,
    "removeComments": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "strict": true,
    // DTO / 实体的属性由框架（class-transformer、Prisma）填充，
    // 不在构造器里赋值。这是装饰器场景必须放宽的一条，其余 strict 全开。
    "strictPropertyInitialization": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // 未使用变量交给 ESLint 报（能配 ^_ 豁免，tsc 不能）
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },

  // 这份 tsconfig 覆盖 **全部** src（含 *.spec.ts）：
  // typecheck 和 ESLint 的 type-aware 规则都靠它，测试文件不在里面就会报
  // "file was not found by the project service"。
  // 打包时排除测试的职责交给 tsconfig.build.json（nest-cli.json 指向它）。
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
